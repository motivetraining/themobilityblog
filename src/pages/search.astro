---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Search | The Mobility Blog"
  description="Search every post on The Mobility Blog."
  canonical="https://www.themobilityblog.com/search"
  noindex
>
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <div class="max-w-wide mx-auto px-4 sm:px-6 py-10 sm:py-14 min-h-[60vh]">
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-8">Search</h1>
    <div id="search"></div>
    <noscript>
      <p class="text-slate-600">
        Search needs JavaScript. You can also <a href="/topics" class="text-teal-700 underline">browse by topic</a>.
      </p>
    </noscript>
    <p class="mt-10 text-sm text-slate-500">
      Or <a href="/topics" class="underline decoration-1 underline-offset-2 hover:text-slate-700">browse by topic</a>.
    </p>
  </div>

  <!--
    The index under /pagefind is generated after `astro build` by the pagefind
    integration in astro.config.mjs, so search works on built output
    (`bun run build && bun run preview`), not under `astro dev`.
  -->
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    (function () {
      if (typeof PagefindUI === "undefined") {
        document.getElementById("search").textContent =
          "Search isn't available in this preview. Run a production build to generate the index.";
        return;
      }
      var ui = new PagefindUI({
        element: "#search",
        showImages: true,
        showSubResults: true,
        resetStyles: false,
        translations: { placeholder: "Search posts, e.g. hip rotation, CARs, isometrics" },
      });
      // Keep the query in the URL so searches can be shared and the back
      // button returns to the same results.
      var params = new URLSearchParams(location.search);
      var q = params.get("q");
      if (q) ui.triggerSearch(q);
      var input = document.querySelector("#search input");
      if (input) {
        input.focus();
        input.addEventListener("input", function () {
          var url = new URL(location.href);
          if (input.value) url.searchParams.set("q", input.value);
          else url.searchParams.delete("q");
          history.replaceState(null, "", url);
        });
      }
    })();
  </script>
</BaseLayout>

<style is:global>
  #search {
    --pagefind-ui-font: "Sora Variable", "Sora", ui-sans-serif, system-ui, sans-serif;
    --pagefind-ui-primary: #0f766e;
    --pagefind-ui-text: #0f172a;
    --pagefind-ui-border: #cbd5e1;
    --pagefind-ui-tag: #f1f5f9;
    --pagefind-ui-border-radius: 12px;
    --pagefind-ui-image-border-radius: 6px;
    --pagefind-ui-image-box-ratio: 16 / 9;
  }
  #search mark {
    background: #ccfbf1;
    color: inherit;
  }
  #search .pagefind-ui__result-link {
    color: #0f766e;
  }
</style>
