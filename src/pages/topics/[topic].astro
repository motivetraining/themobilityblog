---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { TOPICS, TOPIC_SLUGS, MIN_INDEXABLE_TOPIC_POSTS, type TopicSlug } from "@/lib/topics";

export async function getStaticPaths() {
  const posts = (await getCollection("post", ({ data }) => data.published)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  const intros = await getCollection("topic");
  const stray = intros.filter((i) => !(TOPIC_SLUGS as string[]).includes(i.id));
  if (stray.length) {
    throw new Error(
      `Topic intro(s) with no matching topic in src/lib/topics.ts: ${stray.map((i) => i.id).join(", ")}`
    );
  }
  // Only topics with at least one post get a page, so there's never an empty archive.
  return TOPIC_SLUGS.map((topic) => ({
    params: { topic },
    props: {
      topic,
      posts: posts.filter((p) => p.data.tags.includes(topic)),
      intro: intros.find((i) => i.id === topic),
    },
  })).filter((path) => path.props.posts.length > 0);
}

interface Props {
  topic: TopicSlug;
  posts: Awaited<ReturnType<typeof getCollection<"post">>>;
  intro?: Awaited<ReturnType<typeof getCollection<"topic">>>[number];
}
const { topic, posts, intro } = Astro.props;
const { label, description } = TOPICS[topic];
const site = "https://www.themobilityblog.com";
const canonical = `${site}/topics/${topic}`;
const Intro = intro ? (await render(intro)).Content : undefined;

// Tells search engines this page is a collection of the listed posts.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: label,
  description,
  url: canonical,
  isPartOf: { "@type": "WebSite", name: "The Mobility Blog", url: site },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: posts.length,
    itemListElement: posts.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: `${site}/${p.id}`,
      name: p.data.title,
    })),
  },
};
---

<BaseLayout
  title={`${label} | The Mobility Blog`}
  description={description}
  canonical={canonical}
  noindex={posts.length < MIN_INDEXABLE_TOPIC_POSTS}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="hero-band border-b border-slate-200/70">
    <div class="max-w-wide mx-auto px-4 sm:px-6 py-10 sm:py-14">
      <Breadcrumbs
        crumbs={[
          { name: "Home", href: "/" },
          { name: "Topics", href: "/topics" },
          { name: label, href: `/topics/${topic}` },
        ]}
      />
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">{label}</h1>
      {
        Intro ? (
          <div class="prose prose-slate max-w-content mt-5">
            <Intro />
          </div>
        ) : (
          <p class="mt-4 text-lg text-slate-600 max-w-content">{description}</p>
        )
      }
      <p class="mt-6 text-sm font-medium text-slate-500">
        {posts.length} {posts.length === 1 ? "post" : "posts"}
      </p>
    </div>
  </section>
  <div class="max-w-wide mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
      {posts.map((post, i) => <PostCard post={post} eager={i < 3} />)}
    </ul>
  </div>
</BaseLayout>
