---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("post", ({ data }) => data.published);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const canonical = `https://www.themobilityblog.com/${post.id}`;
const pageTitle = `${post.data.metaTitle ?? post.data.title} | The Mobility Blog`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.dateModified ?? post.data.date).toISOString(),
  ...(post.data.featuredImage && { image: post.data.featuredImage }),
  author: {
    "@type": "Person",
    name: "Brian Murray",
  },
  publisher: {
    "@type": "Organization",
    name: "The Mobility Blog",
  },
  mainEntityOfPage: canonical,
};
---

<BaseLayout
  title={pageTitle}
  description={post.data.description}
  canonical={canonical}
  image={post.data.featuredImage}
  type="article"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="max-w-wide mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold tracking-tight mb-3">{post.data.title}</h1>
    <time class="text-sm text-slate-400 block">
      {post.data.date.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })}
    </time>
    <hr class="border-slate-900 mt-6 mb-8" />
    {
      post.data.featuredImage && (
        <img
          src={post.data.featuredImage}
          alt={post.data.title}
          class="w-full aspect-[16/9] object-cover rounded-lg mb-8"
        />
      )
    }
    <div class="prose prose-slate max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
