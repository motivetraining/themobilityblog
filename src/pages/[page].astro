---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const pages = await getCollection("page");
  return pages.map((page) => ({
    params: { page: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const canonical = `https://www.themobilityblog.com/${page.id}`;

// The About page doubles as Brian's author page: every post he wrote points
// its author schema at this @id, so search engines and AI tools can tie the
// articles to one person with stated credentials.
const personJsonLd = page.id === "about" && {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: canonical,
  mainEntity: {
    "@type": "Person",
    "@id": `${canonical}#brian-murray`,
    name: "Brian Murray",
    url: canonical,
    jobTitle: "Mobility Coach",
    description:
      "Mobility coach with sixteen years of experience, founder of Motive Training in Austin, TX, and creator of Motive Mobility.",
    worksFor: { "@type": "Organization", name: "Motive Training", url: "https://www.movewithpurpose.com/" },
    knowsAbout: ["Mobility training", "Functional Range Conditioning", "Kinstretch", "Stretching", "Joint health"],
    sameAs: ["https://www.movewithpurpose.com/meet-the-founder"],
  },
};
---

<BaseLayout
  title={`${page.data.title} | The Mobility Blog`}
  description={page.data.description ?? `${page.data.title} | The Mobility Blog`}
  canonical={canonical}
>
  {personJsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />}
  <article>
    <header class="hero-band border-b border-slate-200/70">
      <div class="max-w-wide mx-auto px-4 sm:px-6 py-10 sm:py-14">
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">{page.data.title}</h1>
      </div>
    </header>
    <div class="max-w-wide mx-auto px-4 sm:px-6 py-10 sm:py-14">
      <div class="prose prose-slate sm:prose-lg max-w-prose prose-headings:scroll-mt-24 prose-p:leading-[1.8]">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
