---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const posts = (await getCollection("post", ({ data }) => data.published)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="The Mobility Blog | Mobility, Stretching & Movement Coaching"
  description="A place for mobility coaches to share what works, and why it works."
  canonical="https://www.themobilityblog.com"
>
  <div class="max-w-5xl mx-auto px-4 py-12">
    <div class="max-w-md mb-10">
      <h1 class="text-3xl font-bold tracking-tight mb-4">The Mobility Blog</h1>
      <p class="text-slate-600">
        A place for mobility coaches to share what works, and <em>why</em> it works.
      </p>
      <p class="text-slate-600 mt-4">
        Some posts are technical, some are philosophical, but the goal stays the same: help you
        build better joint options, think more clearly about movement, and train with more
        intention.
      </p>
    </div>

    <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-12">
      {
        posts.map((post) => (
          <li>
            <a href={`/${post.id}`} class="group block">
              {post.data.featuredImage && (
                <img
                  src={post.data.featuredImage}
                  alt={post.data.title}
                  class="w-full aspect-[16/9] object-cover rounded-lg mb-3"
                  loading="lazy"
                />
              )}
              <h2 class="text-xl font-semibold text-teal-700 underline decoration-1 underline-offset-2 group-hover:text-teal-800">
                {post.data.title}
              </h2>
            </a>
            {post.data.categories[0] && (
              <span class="inline-block mt-1 text-sm text-slate-500 underline decoration-1 underline-offset-2">
                {post.data.categories[0]}
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
