---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | The Mobility Blog"
  description="This page doesn't exist."
  canonical="https://www.themobilityblog.com/404"
>
  <div class="max-w-content mx-auto px-4 py-24 text-center">
    <h1 class="text-3xl font-bold tracking-tight mb-4">Page Not Found</h1>
    <p class="text-slate-600 mb-8">
      The page you're looking for doesn't exist or may have moved.
    </p>
    <a href="/" class="text-teal-700 underline decoration-1 underline-offset-2 hover:text-teal-800">
      Back to The Mobility Blog
    </a>
  </div>
</BaseLayout>
