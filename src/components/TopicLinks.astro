---
import { TOPICS, type TopicSlug } from "@/lib/topics";

interface Props {
  tags: TopicSlug[];
  class?: string;
}
const { tags, class: className = "" } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class={`flex flex-wrap gap-2 ${className}`} aria-label="Topics" data-pagefind-ignore>
      {tags.map((tag) => (
        <li>
          <a
            href={`/topics/${tag}`}
            class="inline-block rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600 transition-colors hover:bg-teal-700 hover:text-white"
          >
            {TOPICS[tag].label}
          </a>
        </li>
      ))}
    </ul>
  )
}
