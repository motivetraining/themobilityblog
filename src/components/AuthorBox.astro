---
import { withUtm } from "@/lib/utm.mjs";

// End-of-post author section for Brian's posts. One component instead of a
// bio pasted into every Markdown file, so it stays consistent and editable in
// one place. Guest posts carry their own "About the Author" in the body.
const motive = withUtm("https://www.movewithpurpose.com/", { medium: "author-box", content: "motive-training" });
const online = withUtm("https://www.movewithpurpose.com/kinstretch-online", {
  medium: "author-box",
  content: "kinstretch-online",
});
---

<aside
  aria-labelledby="about-the-author"
  class="hero-band mt-14 rounded-2xl ring-1 ring-slate-200 p-6 sm:p-8"
  data-pagefind-ignore
>
  <h2 id="about-the-author" class="text-xs font-semibold uppercase tracking-[0.14em] text-teal-700 mb-3">About the Author</h2>
  <p class="text-slate-700 leading-relaxed">
    <a href="/about" class="font-semibold text-teal-700 underline decoration-1 underline-offset-2 hover:text-teal-800">Brian Murray</a>
    is a mobility coach with sixteen years of experience helping people move better, feel stronger, and train
    without pain. He founded <a href={motive} class="text-teal-700 underline decoration-1 underline-offset-2 hover:text-teal-800">Motive Training</a>,
    a personal training studio in Austin, TX, and created
    <a href={online} class="text-teal-700 underline decoration-1 underline-offset-2 hover:text-teal-800">Motive Mobility</a>,
    an online platform for joint health and movement longevity that includes KINSTRETCH Online. His coaching draws on
    Functional Range Conditioning (FRC), WeckMethod, and years of hands-on work, with the goal of making complex ideas
    simple enough to use.
  </p>
</aside>
