---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import TopicLinks from "@/components/TopicLinks.astro";
import { readingMinutes, formatShortDate } from "@/lib/reading-time";

interface Props {
  post: CollectionEntry<"post">;
  eager?: boolean;
  /** The `sizes` hint for the image; depends on how wide the grid's columns are. */
  sizes?: string;
  /** Heading level for the title: h3 when the cards sit under an H2 section heading. */
  heading?: "h2" | "h3";
}
const {
  post,
  eager = false,
  heading: Heading = "h2",
  sizes = "(min-width: 1024px) 340px, (min-width: 640px) calc(50vw - 40px), calc(100vw - 32px)",
} = Astro.props;
---

<li class="flex flex-col">
  <a href={`/${post.id}`} class="group block">
    {
      post.data.featuredImage && (
        <div class="card-image mb-4">
          <Image
            src={post.data.featuredImage}
            alt=""
            width={800}
            height={450}
            quality={75}
            widths={[400, 640, 800]}
            sizes={sizes}
            loading={eager ? "eager" : "lazy"}
            decoding="async"
          />
        </div>
      )
    }
    <p class="text-xs font-medium text-slate-500">
      <time datetime={post.data.date.toISOString()}>{formatShortDate(post.data.date)}</time>
      <span aria-hidden="true"> · </span>
      {readingMinutes(post.body)} min read
    </p>
    <Heading class="mt-1.5 text-lg font-semibold leading-snug tracking-tight text-slate-900 transition-colors group-hover:text-teal-700">
      {post.data.title}
    </Heading>
    <p class="mt-2 text-sm leading-relaxed text-slate-600 line-clamp-3">{post.data.description}</p>
  </a>
  <TopicLinks tags={post.data.tags} class="mt-3" />
</li>
