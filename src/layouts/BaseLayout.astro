---
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
}
const { title, description, canonical, type = "website", publishedTime, modifiedTime } = Astro.props;
const image = Astro.props.image ?? "https://www.themobilityblog.com/favicon.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="The Mobility Blog" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "The Mobility Blog",
        url: "https://www.themobilityblog.com",
      })}
    />
  </head>
  <body class="min-h-screen bg-white text-slate-900 flex flex-col font-sans">
    <div class="h-1.5 w-full bg-gradient-to-r from-purple-400 via-sky-400 to-emerald-400"></div>
    <header class="border-b border-slate-200">
      <div class="max-w-wide mx-auto px-4 py-6 flex items-center justify-between">
        <a href="/" class="font-bold text-lg tracking-tight">The Mobility Blog</a>
        <nav class="flex items-center gap-6 text-sm">
          <a href="/about" class="hover:underline">About</a>
          <a href="/write-with-us" class="hover:underline">Write With Us</a>
          <a href="https://motive-mobility.circle.so/c/welcome-start-here" class="hover:underline">
            KINSTRETCH Online
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-slate-200 mt-16">
      <div
        class="max-w-wide mx-auto px-4 py-8 text-sm text-slate-500 flex flex-wrap items-center justify-between gap-4"
      >
        <span>&copy; {new Date().getFullYear()} The Mobility Blog</span>
        <nav class="flex items-center gap-5">
          <a href="https://www.movewithpurpose.com/" class="hover:underline">Our Sponsor</a>
          <a href="https://www.instagram.com/themobilityblog/" class="hover:underline">Instagram</a>
          <a href="/privacy-policy" class="hover:underline">Privacy Policy</a>
          <a href="/rss.xml" class="hover:underline">RSS</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
