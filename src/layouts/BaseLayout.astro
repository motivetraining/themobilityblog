---
import "@fontsource-variable/sora";
import "@/styles/global.css";
// The Latin subset of Sora, preloaded so text renders in the right font on
// first paint. The font is served from this site (no request to Google Fonts).
import soraLatin from "@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url";
import { withUtm } from "@/lib/utm.mjs";
import { TOPICS } from "@/lib/topics";

interface Props {
  title: string;
  description: string;
  canonical: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Shows the reading-progress bar (posts only). */
  progress?: boolean;
}
const {
  title,
  description,
  canonical,
  type = "website",
  noindex = false,
  publishedTime,
  modifiedTime,
  progress = false,
} = Astro.props;
// Social crawlers (Facebook, LinkedIn, X, iMessage) ignore relative og:image
// URLs, so every image path is resolved against the site origin. Pages without
// their own image share the site card (1200×630).
const hasOwnImage = Boolean(Astro.props.image);
const image = new URL(Astro.props.image ?? "/og-default.jpg", Astro.site).href;
const imageAlt = Astro.props.imageAlt ?? (hasOwnImage ? title : "The Mobility Blog: mobility, stretching, and joint health from coaches who teach it");

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const navLinks = [
  { href: "/topics", label: "Topics" },
  { href: "/about", label: "About" },
  { href: "/write-with-us", label: "Write With Us" },
];
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
const kinstretch = withUtm("https://www.movewithpurpose.com/kinstretch-online", {
  medium: "nav",
  content: "kinstretch-online",
});
const footerTopics = (["fundamentals", "stretching", "isometrics", "hips", "programming"] as const).map((slug) => ({
  slug,
  label: TOPICS[slug].label,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={soraLatin} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="msvalidate.01" content="151707BBD6F91EAA765AB9B659C7962B" />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="max-image-preview:large" />}
    <link rel="alternate" type="application/rss+xml" title="The Mobility Blog" href="/rss.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="The Mobility Blog" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    {!hasOwnImage && <meta property="og:image:width" content="1200" />}
    {!hasOwnImage && <meta property="og:image:height" content="630" />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "The Mobility Blog",
        url: "https://www.themobilityblog.com",
        inLanguage: "en-US",
        publisher: {
          "@type": "Organization",
          name: "The Mobility Blog",
          url: "https://www.themobilityblog.com",
          logo: "https://www.themobilityblog.com/apple-touch-icon.png",
          sameAs: ["https://www.instagram.com/themobilityblog/"],
        },
      })}
    />
  </head>
  <body class="min-h-screen bg-white text-slate-900 flex flex-col font-sans">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[70] focus:bg-white focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-lg"
    >
      Skip to content
    </a>
    {progress && <div class="reading-progress" aria-hidden="true" />}
    <div class="h-1 w-full bg-gradient-to-r from-purple-400 via-sky-400 to-emerald-400"></div>
    <header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/85 backdrop-blur-md">
      <div class="max-w-wide mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        <a href="/" class="group flex items-center gap-2.5 font-bold text-lg tracking-tight">
          <img src="/logo-mark.png" alt="" width="36" height="36" class="h-9 w-9 transition-transform duration-500 group-hover:-rotate-12" />
          The Mobility Blog
        </a>

        <nav aria-label="Main" class="hidden md:flex items-center gap-1 text-sm font-medium">
          {
            navLinks.map((l) => (
              <a
                href={l.href}
                aria-current={isCurrent(l.href) ? "page" : undefined}
                class:list={[
                  "rounded-full px-3.5 py-2 transition-colors hover:bg-slate-100 hover:text-slate-900",
                  isCurrent(l.href) ? "text-teal-700" : "text-slate-600",
                ]}
              >
                {l.label}
              </a>
            ))
          }
          <a
            href="/search"
            aria-label="Search"
            aria-current={isCurrent("/search") ? "page" : undefined}
            class="rounded-full p-2.5 text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900"
          >
            <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="w-[18px] h-[18px]">
              <circle cx="8.5" cy="8.5" r="5.5"></circle>
              <path d="M13 13l4.5 4.5" stroke-linecap="round"></path>
            </svg>
          </a>
          <a
            href={kinstretch}
            class="ml-2 rounded-full bg-slate-900 px-4 py-2 text-white shadow-sm transition-colors hover:bg-teal-700"
          >
            KINSTRETCH Online
          </a>
        </nav>

        {/* Phones: search stays one tap away; the rest folds into a menu that
            works without JavaScript (a native <details> disclosure). */}
        <div class="flex md:hidden items-center gap-1">
          <a href="/search" aria-label="Search" class="rounded-full p-2.5 text-slate-700 hover:bg-slate-100">
            <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5">
              <circle cx="8.5" cy="8.5" r="5.5"></circle>
              <path d="M13 13l4.5 4.5" stroke-linecap="round"></path>
            </svg>
          </a>
          <details class="mobile-menu group/menu">
            <summary
              aria-label="Menu"
              class="list-none [&::-webkit-details-marker]:hidden cursor-pointer rounded-full p-2.5 text-slate-700 hover:bg-slate-100"
            >
              <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="w-5 h-5">
                <path class="group-open/menu:hidden" d="M3 5.5h14M3 10h14M3 14.5h14"></path>
                <path class="hidden group-open/menu:block" d="M5 5l10 10M15 5L5 15"></path>
              </svg>
            </summary>
            <nav
              aria-label="Main"
              class="absolute inset-x-0 top-full border-b border-slate-200 bg-white shadow-lg px-4 py-3 flex flex-col text-base font-medium"
            >
              {
                navLinks.map((l) => (
                  <a
                    href={l.href}
                    aria-current={isCurrent(l.href) ? "page" : undefined}
                    class:list={["rounded-lg px-3 py-3 hover:bg-slate-100", isCurrent(l.href) ? "text-teal-700" : "text-slate-800"]}
                  >
                    {l.label}
                  </a>
                ))
              }
              <a href={kinstretch} class="mt-2 mb-1 rounded-full bg-slate-900 px-4 py-3 text-center text-white">
                KINSTRETCH Online
              </a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-20 bg-slate-950 text-slate-400">
      <div class="h-1 w-full bg-gradient-to-r from-purple-400 via-sky-400 to-emerald-400"></div>
      <div class="max-w-wide mx-auto px-4 sm:px-6 py-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr] text-sm">
        <div>
          <p class="font-bold text-lg tracking-tight text-white">The Mobility Blog</p>
          <p class="mt-3 max-w-xs leading-relaxed">
            A place for mobility coaches to share what works, and why it works.
          </p>
          <a
            href="/write-with-us"
            class="mt-5 inline-flex items-center gap-1.5 font-medium text-emerald-300 hover:text-emerald-200"
          >
            Write with us <span aria-hidden="true">→</span>
          </a>
        </div>
        <nav aria-label="Topics">
          <p class="font-semibold text-white mb-4">Topics</p>
          <ul class="space-y-2.5">
            {
              footerTopics.map((t) => (
                <li>
                  <a href={`/topics/${t.slug}`} class="hover:text-white">
                    {t.label}
                  </a>
                </li>
              ))
            }
            <li><a href="/topics" class="hover:text-white">All topics</a></li>
          </ul>
        </nav>
        <nav aria-label="Site">
          <p class="font-semibold text-white mb-4">The Blog</p>
          <ul class="space-y-2.5">
            <li><a href="/what-is-mobility" class="hover:text-white">Start Here</a></li>
            <li><a href="/about" class="hover:text-white">About</a></li>
            <li><a href="/write-with-us" class="hover:text-white">Write With Us</a></li>
            <li><a href="/search" class="hover:text-white">Search</a></li>
            <li><a href="/rss.xml" class="hover:text-white">RSS</a></li>
          </ul>
        </nav>
        <nav aria-label="Footer">
          <p class="font-semibold text-white mb-4">Elsewhere</p>
          <ul class="space-y-2.5">
            <li>
              <a href={withUtm("https://www.movewithpurpose.com/", { medium: "footer", content: "our-sponsor" })} class="hover:text-white">Our Sponsor</a>
            </li>
            <li>
              <a href={withUtm("https://www.movewithpurpose.com/kinstretch-online", { medium: "footer", content: "kinstretch-online" })} class="hover:text-white">KINSTRETCH Online</a>
            </li>
            <li><a href="https://www.instagram.com/themobilityblog/" class="hover:text-white">Instagram</a></li>
            <li><a href="/privacy-policy" class="hover:text-white">Privacy Policy</a></li>
          </ul>
        </nav>
      </div>
      <div class="border-t border-white/10">
        <p class="max-w-wide mx-auto px-4 sm:px-6 py-6 text-xs text-slate-500">
          &copy; {new Date().getFullYear()} The Mobility Blog
        </p>
      </div>
    </footer>
  </body>
</html>
